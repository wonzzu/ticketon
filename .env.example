

# --- Spring 프로파일 ---
SPRING_PROFILES_ACTIVE=prod

# --- DB (docker-compose의 mysql 컨테이너와 동일하게) ---
DB_USERNAME=ticketing
DB_PASSWORD=여기_강한_비밀번호
MYSQL_ROOT_PASSWORD=여기_root_비밀번호
MYSQL_DATABASE=ticketing

# --- JWT (32바이트 이상 랜덤 문자열) ---
# 생성 예: openssl rand -base64 48
JWT_SECRET=여기_최소32바이트_랜덤_시크릿

# --- Kafka 3 Broker ---
# 노트북에서 집 PC 클러스터를 사용할 때 localhost 대신 Tailscale IP를 입력한다.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094,localhost:9095,localhost:9096
KAFKA_TOPIC_REPLICATION_FACTOR=3
